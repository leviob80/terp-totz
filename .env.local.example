# Stripe — get keys from dashboard.stripe.com
# Use test keys (sk_test_...) during development
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend — get API key from resend.com
# Used for contact form emails and newsletter signups
RESEND_API_KEY=re_...

# Resend Audience ID — create an audience in the Resend dashboard
# Used to store newsletter subscribers
RESEND_AUDIENCE_ID=...

# App URL (used in Stripe redirect and email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
